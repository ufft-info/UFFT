import FaceGraph.Theorem31
import Mathlib.NumberTheory.Zsqrtd.GaussianInt
import Mathlib.RingTheory.Localization.FractionRing

/-!
# Quarter flux (Theorem 6.4 of the note at q = 6), machine-checked over the Gaussian integers

`D6` is the magnetic Laplacian Δ₆ of the note's equation (L6) in the gauge (B): squares first (index 2a + (0 if σ = +1
else 1) for the square (a, σ)), then the eight hexagons in the order of `itertools.product([1,-1], repeat=3)`;
every off-diagonal entry is 0, ±1 or ±i. A Gaussian-integer matrix is written here as `ofRI R I` with `R`, `I` its real
and imaginary integer parts, so that every matrix identity reduces to identities between integer matrices, which the
kernel decides by evaluation (`decide +kernel` on `Matrix.mulᵣ`).

The proof follows the note's Section 6.1: the Walsh vectors χ_S of the cube, S ⊆ {1,2,3}, together with their square
partners B χ_S, span invariant planes with blocks [[4, -1], [-4, 6 - μ]] (μ = 1 for |S| = 1, μ = -1 for |S| = 2), and the
two Walsh vectors with |S| = 0, 3 are eigenvectors with eigenvalues 3 and 9. The change of basis `P6` has Gaussian-integer
entries and `Q6 = P6ᴴ` satisfies `Q6 * P6 = diag(32, 8, …)`, so `P6` is invertible over the fraction field ℚ(i); the
characteristic polynomial is compared there and pulled back by injectivity of `Polynomial.map`.
-/

open Matrix Polynomial

local notation "ℤ[i]" => GaussianInt

/-! ## Gaussian-integer matrices from integer parts -/

/-- A Gaussian-integer matrix from its real and imaginary integer parts. -/
def ofRI {m n : Type*} (A B : Matrix m n ℤ) : Matrix m n ℤ[i] := fun i j => ⟨A i j, B i j⟩

lemma Zsqrtd.re_sum {d : ℤ} {ι : Type*} (s : Finset ι) (f : ι → ℤ√d) :
    (∑ k ∈ s, f k).re = ∑ k ∈ s, (f k).re := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, Zsqrtd.re_add, ih]

lemma Zsqrtd.im_sum {d : ℤ} {ι : Type*} (s : Finset ι) (f : ι → ℤ√d) :
    (∑ k ∈ s, f k).im = ∑ k ∈ s, (f k).im := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, Zsqrtd.im_add, ih]

/-- Matrix product in terms of real and imaginary parts: (R + iI)(R' + iI') = (RR' - II') + i(RI' + IR'). -/
lemma ofRI_mul {l m n : Type*} [Fintype m] (A B : Matrix l m ℤ) (C D : Matrix m n ℤ) :
    ofRI A B * ofRI C D = ofRI (A * C - B * D) (A * D + B * C) := by
  ext i j
  · simp only [Matrix.mul_apply, ofRI, Zsqrtd.re_sum, Zsqrtd.re_mul, Matrix.sub_apply]
    rw [sub_eq_add_neg, ← Finset.sum_neg_distrib, ← Finset.sum_add_distrib]
    simp
  · simp only [Matrix.mul_apply, ofRI, Zsqrtd.im_sum, Zsqrtd.im_mul, Matrix.add_apply]
    simp [← Finset.sum_add_distrib]

lemma ofRI_zero_eq_map {m n : Type*} (A : Matrix m n ℤ) :
    ofRI A 0 = A.map (Int.castRingHom ℤ[i]) := by
  ext i j <;> simp [ofRI]

lemma ofRI_diagonal {n : Type*} [DecidableEq n] (v : n → ℤ) :
    Matrix.diagonal (fun i => ((v i : ℤ) : ℤ[i])) = ofRI (Matrix.diagonal v) 0 := by
  ext i j <;> simp [ofRI, Matrix.diagonal_apply] <;> split_ifs <;> simp

