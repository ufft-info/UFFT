  rw [show blkRhombic 4 = !![6, 0; 0, 6] from rfl, cp2]; simp [Polynomial.C_ofNat]; try ring
lemma blkRhombic5 : (blkRhombic 5).charpoly = (X - 6) ^ 2 := by
  rw [show blkRhombic 5 = !![6, 0; 0, 6] from rfl, cp2]; simp [Polynomial.C_ofNat]; try ring
theorem charpoly_BRhombic : BRhombic.charpoly = X * (X - 6) ^ 5 * (X - 4) ^ 3 * (X - 2) ^ 3 := by
  unfold BRhombic
  rw [Matrix.charpoly_reindex, charpoly_blockDiagonal, Fin.prod_univ_six,
    blkRhombic0, blkRhombic1, blkRhombic2, blkRhombic3, blkRhombic4, blkRhombic5]
  try ring
theorem charpoly_LRhombic : LRhombic.charpoly = X * (X - 6) ^ 5 * (X - 4) ^ 3 * (X - 2) ^ 3 := by
  rw [LRhombic_conj, ← charpoly_BRhombic]
  have h := Matrix.charpoly_units_conj PunitRhombic BRhombic
  rw [← Matrix.coe_units_inv] at h
  exact h
/-- Table 2 row for the rhombic, for the rule-built Laplacian. -/
theorem charpoly_LrhombicG : LrhombicG.charpoly = X * (X - 6) ^ 5 * (X - 4) ^ 3 * (X - 2) ^ 3 := by
  rw [LRhombicG_eq]; exact charpoly_LRhombic
