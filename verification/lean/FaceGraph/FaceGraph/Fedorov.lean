/-- The rule-built Laplacian is the literal. -/
theorem LRhombicG_eq : LrhombicG = LRhombic := by decide +kernel
lemma LPRhombic : LRhombic * PRhombic = PRhombic * BRhombic := by rw [← Matrix.mulᵣ_eq, ← Matrix.mulᵣ_eq]; decide +kernel
lemma PQRhombic : PRhombic * QRhombic = 1 := by rw [← Matrix.mulᵣ_eq]; decide +kernel
lemma QPRhombic : QRhombic * PRhombic = 1 := by rw [← Matrix.mulᵣ_eq]; decide +kernel
def PunitRhombic : (Matrix (Fin 12) (Fin 12) ℚ)ˣ := ⟨PRhombic, QRhombic, PQRhombic, QPRhombic⟩
