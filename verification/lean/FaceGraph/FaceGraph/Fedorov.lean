  calc LRhombic = LRhombic * (PRhombic * QRhombic) := by rw [PQRhombic, mul_one]
    _ = (LRhombic * PRhombic) * QRhombic := by rw [mul_assoc]
    _ = PRhombic * BRhombic * QRhombic := by rw [LPRhombic]
lemma blkRhombic0 : (blkRhombic 0).charpoly = X * (X - 4) := by
  rw [show blkRhombic 0 = !![0, 0; 0, 4] from rfl, cp2]; simp [Polynomial.C_ofNat]; try ring
lemma blkRhombic1 : (blkRhombic 1).charpoly = (X - 4) ^ 2 := by
  rw [show blkRhombic 1 = !![4, 0; 0, 4] from rfl, cp2]; simp [Polynomial.C_ofNat]; try ring
